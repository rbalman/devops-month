# Rendered by Ansible onto each app instance. Two containers on one network:
# nginx (published on :80, the ALB target) proxies /api to the backend, which
# talks to Postgres on the dedicated db instance.
services:
  backend:
    image: {{ backend_image }}
    environment:
      # Discrete PG* vars, not a DATABASE_URL — so special characters in the
      # password (#, @, :, /) don't need URL-encoding and can't break parsing.
      PGHOST: "{{ db_host }}"
      PGPORT: "5432"
      PGUSER: "{{ db_username }}"
      PGPASSWORD: "{{ db_password }}"
      PGDATABASE: "{{ db_name }}"
      PORT: "3000"
    restart: always

  frontend:
    image: {{ frontend_image }}
    ports:
      - "80:80"
    depends_on:
      - backend
    restart: always
