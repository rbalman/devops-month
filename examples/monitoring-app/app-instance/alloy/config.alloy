// Alloy pipeline: discover containers → set a clean `container` label →
// tail their stdout → push to the REMOTE Loki on the observability host.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // Use the Docker Compose service name (e.g. "random-logger") as the container
  // label. The raw container name is "app-instance-random-logger-1", which is
  // ugly to query; the compose service label is clean and stable.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "container"
  }
}

loki.source.docker "logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  // Replace OBS_PRIVATE_IP with the observability host's PRIVATE IP
  // (from `terraform output observability_private_ip`). Alloy retries until Loki is up.
  endpoint {
    url = "http://OBS_PRIVATE_IP:3100/loki/api/v1/push"
  }
}
